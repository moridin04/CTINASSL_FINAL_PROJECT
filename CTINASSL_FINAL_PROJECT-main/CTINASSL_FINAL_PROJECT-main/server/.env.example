# Example environment variables for FlickNest backend

# Server runtime
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/flicknest

# Production mode: serve React frontend from Express
# Set to 'true' to serve the built React app from this server
# (automatically true when NODE_ENV=production)
SERVE_FRONTEND=false

# REQUIRED secrets (do not commit real values)
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too

# Password hashing
# Higher is slower but safer (12 is a good default)
BCRYPT_COST=12

# Session/token timeouts
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Account lockout (brute-force protection)
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MS=900000

# Cookies (for refresh token + CSRF double-submit token)
# Use 'none' only when you also set NODE_ENV=production and serve over HTTPS.
COOKIE_SAMESITE=lax

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_REGISTER_MAX=20

# Optional: allow creating admin/super-admin via /api/auth/register
SUPER_ADMIN_SECRET=change_me_super_admin

# CORS allow-list (comma-separated)
CORS_ORIGINS=http://localhost:3000

# HTTPS / TLS (recommended for production)
# Option A: terminate TLS at a reverse proxy (Nginx/Render/Heroku/etc)
# Option B: run Node with HTTPS directly by providing cert paths
#SSL_KEY_PATH=C:\\path\\to\\key.pem
#SSL_CERT_PATH=C:\\path\\to\\cert.pem

# Redirect http -> https (useful behind reverse proxy with x-forwarded-proto)
#ENFORCE_HTTPS=true

# Enable HSTS preload (only if domain is submitted to https://hstspreload.org/)
# HSTS is always enabled in production, but preload requires manual submission
#HSTS_PRELOAD=true
